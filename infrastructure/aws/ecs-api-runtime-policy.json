{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AuroraDataApi",
      "Effect": "Allow",
      "Action": [
        "rds-data:BeginTransaction",
        "rds-data:CommitTransaction",
        "rds-data:RollbackTransaction",
        "rds-data:ExecuteStatement",
        "rds-data:BatchExecuteStatement"
      ],
      "Resource": "arn:aws:rds:us-east-1:632930644527:cluster:geo-intelligence-demo"
    },
    {
      "Sid": "AuroraManagedSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:us-east-1:632930644527:secret:rds!cluster-5781692e-74a2-45db-a7a0-5c97200f9e7f-agmIEg"
    },
    {
      "Sid": "InvokeCrawlerBridge",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:us-east-1:632930644527:function:geo-intelligence-scheduler-bridge"
    },
    {
      "Sid": "ManageCrawlerSchedules",
      "Effect": "Allow",
      "Action": [
        "scheduler:GetSchedule",
        "scheduler:UpdateSchedule"
      ],
      "Resource": "arn:aws:scheduler:us-east-1:632930644527:schedule/geo-intelligence-crawlers/*"
    },
    {
      "Sid": "PassSchedulerExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::632930644527:role/geo-intelligence-scheduler-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "scheduler.amazonaws.com"
        }
      }
    }
  ]
}
